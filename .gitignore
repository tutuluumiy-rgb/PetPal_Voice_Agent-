# ── 环境变量（含 API key，绝对不能提交）──
.env
*.env
.env.*

# ── Python 缓存 ──
__pycache__/
*.pyc
*.pyo

# ── 模型文件（体积大，可重新下载）──
backend/models/
testboard/vad/*.wasm
testboard/vad/*.onnx
frontend/renderer/public/vad/*.onnx
frontend/renderer/public/vad/*.wasm
frontend/renderer/public/kws/
frontend/resources/kws/

# ── 临时文件 ──
test.mp3
Untitled

# ── 运行时会话数据（含用户说话内容，绝不提交）──
backend/sessions/
backend/sessions_*_tmp/
# 长期记忆库（含用户隐私/偏好，绝不提交；可随时重建）
backend/memories/
backend/memories_*_tmp/

# ── 运行时设置（本地个性化，不入库）──
backend/data/

# ── 前端会话日志（含对话内容，绝不提交）──
frontend/docs/session.jsonl

# ── 动画帧源素材目录（已生成副本提交于 renderer/public/pet-anim，勿重复入库）──
frontend/pictures/

# ── Electron 构建产物（预留）──
backend/build/
backend/dist/

# ── 日志 ──
*.log
tmp/
