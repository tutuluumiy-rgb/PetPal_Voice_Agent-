# ── 环境变量（含 API key，绝对不能提交）──
.env
*.env
.env.*

# ── Python 缓存 ──
__pycache__/
*.pyc
*.pyo

# ── 模型文件（体积大，可重新下载）──
backend/models/
testboard/vad/*.wasm
testboard/vad/*.onnx
frontend/renderer/public/vad/*.onnx
frontend/renderer/public/vad/*.wasm
frontend/renderer/public/kws/
frontend/resources/kws/

# ── 临时文件 ──
test.mp3
Untitled

# ── 运行时会话数据（含用户说话内容，绝不提交）──
backend/sessions/
backend/sessions_*_tmp/

# ── Electron 构建产物（预留）──
backend/build/
backend/dist/

# ── 日志 ──
*.log
tmp/
